# ========================================
# CONFIGURAÇÃO DE AMBIENTE
# ========================================
# production = robô operando em modo REAL com Bybit e Binance
# ATENÇÃO: Sistema sempre opera com contas REAIS!
ENVIRONMENT=production

# ========================================
# RASTREAMENTO / ESCADA DE LUCRO (ROI %)
# ========================================
# Ativa a "trava de lucro" clássica somente quando ROI >= este valor (legado)
TRAILING_TRIGGER_ROI=15
TRAILING_REVERSAO_ROI=20
TRAILING_PROFIT_FLOOR_ROI=1
# Escada de Lucro: ao bater +100% ROI, move SL para travar +80% e deixa correr
ENABLE_PROFIT_SHIELD=true
PROFIT_SHIELD_TRIGGER_ROI=100
PROFIT_SHIELD_LOCK_ROI=80
# Anti-Chase — bloqueia entradas no topo/fundo esticados
ENABLE_ANTI_CHASE_GATE=true
ANTI_CHASE_RSI_5M_LONG_MAX=68
ANTI_CHASE_RSI_1M_LONG_MAX=75
ANTI_CHASE_RSI_5M_SHORT_MIN=32
ANTI_CHASE_RSI_1M_SHORT_MIN=25
ANTI_CHASE_MAX_EXTENSION_PCT=2.0
ANTI_CHASE_PULLBACK_TOL_PCT=0.90
ANTI_CHASE_EMA_FAST=8
ANTI_CHASE_EMA_SLOW=20
# Gestão Trend-Following — segue tendência até vela forte + volume contra
ENABLE_TREND_POSITION_MANAGER=true
TREND_POS_POLL_SECS=8
BREAKEVEN_ROI_PCT=100
BREAKEVEN_PRICE_PCT=5.0
BREAKEVEN_FEE_BUFFER_PCT=0.12
TREND_TRAIL_ROI_PCT=100
TREND_TRAIL_DIST_MIN_PCT=2.0
TREND_TRAIL_DIST_MAX_PCT=3.0
TREND_LOCK_ROI_PCT=80
TREND_TRAIL_EMA=8
TREND_EXIT_EMA=20
TREND_EXIT_VOL_RATIO=2.2
TREND_EXIT_BODY_PCT=55
MAX_HOLD_SECS=14400
STAGNATION_ROI_ABS=0
STAGNATION_NO_EXTREME_SECS=14400
# Envia takeProfit +100% ROI na Bybit (linha no gráfico). false = só SL
ATTACH_EXCHANGE_TP=true
# Analista: não sai em recuo saudável
ENABLE_PERSONAL_ANALYST=true
ANALYST_EXIT_GIVEBACK_PCT=70
ANALYST_EXIT_MIN_PEAK_ROI=100
ANALYST_EXIT_MOMENTUM_FADE_ROI=120
# Feedback Loop — intervalo de reconciliação get_closed_pnl (segundos)
FEEDBACK_SYNC_INTERVAL_SECS=30
# Timeout da validação de API ao vincular investidor (segundos)
BYBIT_VALIDATE_TIMEOUT_SECS=12
FEEDBACK_LEARNING_RATE=0.03
FEEDBACK_WEIGHT_MIN=0.10
FEEDBACK_WEIGHT_MAX=0.60
# Entrada assimétrica: SHORT em derretimento agressivo | LONG (modo moderado: não rígido)
AGGRESSIVE_MELTDOWN_SHORT=true
RIGID_LONG_ENTRIES=false
MELTDOWN_DROP_PCT=1.2
MELTDOWN_BODY_PCT=55
WHALE_SCORE_MIN_LONG=28

# ========================================
# GESTÃO DE RISCO — TAMANHO DA POSIÇÃO
# ========================================
# Percentual da banca por ordem (padrão 5%)
RISK_PER_TRADE_PCT=5
# Teto se o Step Size / minOrderQty forçar arredondamento para cima (padrão 7.5%)
MAX_ENTRY_TOLERANCE_PCT=7.5
# Percentual após STOP_LOSS (padrão 3%)
ENTRY_AFTER_STOP_PCT=3
# Mínimo de velas diárias (D) para operar um par — modo MODERADO: 14 dias
MIN_DAILY_CANDLES=14
# Horas de castigo na mesma moeda após Stop Loss (anti-reentrada)
COOLDOWN_AFTER_STOP_HOURS=24
# Fração da amplitude onde o close deve estar (anatomia da vela)
CANDLE_CLOSE_ZONE_FRAC=0.45
# Lookback da média de spread para anti-faca caindo
FALLING_KNIFE_SPREAD_MA=20

# ========================================
# INTELIGÊNCIA DE MERCADO (IA INSTITUCIONAL)
# ========================================
# Ativa análise de regime, baleias, notícias e timing
ENABLE_MARKET_INTELLIGENCE=true
# Bloqueia entradas em mercado lateral (range/consolidação)
BLOCK_LATERAL_MARKETS=true
# Amplitude % dos últimos X candles: abaixo do limite = acumulação → força NEUTRO
# Fórmula: ((High.max - Low.min) / Low.min) * 100
LATERAL_AMPLITUDE_PERIODS=20
LATERAL_AMPLITUDE_PCT=0.28
# Modo moderado — mais entradas sem desligar segurança
STRUCTURE_ADX_MIN=19
STRUCTURE_REQUIRE_BB_EXPAND=false
LATERAL_SCORE_BLOCK=58
# Porta 3 — σ adaptativo por ADX médio (MODERADO: 1.2 / 1.3 / 1.5)
PORTA3_SIGMA_CONSOLIDATION=1.2
PORTA3_SIGMA_MODERATE=1.3
PORTA3_SIGMA_STRONG=1.5
PORTA3_ADX_CONSOLIDATION_MAX=15
PORTA3_ADX_MODERATE_MAX=25
PORTA3_SPREAD_MULT=1.2
ANALYST_ENTRY_MIN_SCORE=45
# ========================================
# ASSISTENTES IA (Groq fluxo + Gemini macro) — incrementais
# ========================================
# Análise de Order Book via Groq (JSON score_fluxo). Fallback local se falhar.
ENABLE_GROQ_FLOW_AI=true
# Análise macro/notícias via Gemini (JSON sentimento). Soft por padrão.
ENABLE_GEMINI_MACRO_AI=true
# Só True se quiser que filtro_noticia_travar_bot ABORTE a entrada (hard veto).
ALLOW_NEWS_HARD_VETO=false

# ========================================
# BANCO SQLite (persistência de clientes/API keys)
# ========================================
# Preferir pasta data/ do projeto (não use /tmp no Render — some no restart)
SQLITE_DB_PATH=./data/database.db
# Só force /tmp se souber o que está fazendo: FORCE_TMP_SQLITE=1

# ========================================
# CONTROLE DE EXECUÇÃO DE ORDENS
# ========================================
# true = executa ordens reais na Bybit/Binance
# false = sistema em modo seguro (não executa ordens)
ALLOW_ORDER_EXECUTION=true

# Habilita trading em conta real
# true = ordens reais ativas (PRODUÇÃO)
# false = ordens bloqueadas (SEGURANÇA)
ALLOW_REAL_TRADING=true

# ⚠️  ATENÇÃO: USE_TESTNET controla se ordens vão para contas reais ou testnet
# false = ordens vão para suas contas REAIS na Bybit/Binance
# true = ordens vão para contas de TESTE (testnet) - não aparecem nas contas reais!
# 🔧 Para operar com dinheiro real, mantenha USE_TESTNET=false
USE_TESTNET=false
# NUNCA deixe USE_TESTNET=true + ALLOW_REAL_TRADING=true — o robô opera mainnet real.
# Bypass de ordem forçada (debug) só com FORCAR_SINAL_TESTE=true e ALLOW_REAL_TRADING=false
FORCAR_SINAL_TESTE=false

# ========================================
# SALDO FICTÍCIO (TREINO/TESTNET)
# ========================================
# Quando USE_TESTNET=true e as chaves não autenticarem (ex.: retCode=10003),
# o dashboard pode usar um saldo fictício para o robô "treinar" sem travar em $0.
# - Se ENABLE_TRAINING_FAKE_BALANCE não for definido, o padrão é:
#   - true em TESTNET
#   - false em MAINNET
ENABLE_TRAINING_FAKE_BALANCE=
# Valor do saldo fictício (USDT)
TRAINING_FAKE_BALANCE_USD=500

# ========================================
# CREDENCIAIS BYBIT
# ========================================
# Obtenha em: https://www.bybit.com/app/user/api-management
# Permissões necessárias: Read Position + Trade Orders
# IMPORTANTE: Desative 2FA na API Key (não na conta)
BYBIT_API_KEY=YOUR_BYBIT_API_KEY
BYBIT_API_SECRET=YOUR_BYBIT_API_SECRET

# ========================================
# TELEGRAM (NOTIFICAÇÕES)
# ========================================
TELEGRAM_TOKEN=YOUR_TELEGRAM_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ========================================
# INTELIGÊNCIA ARTIFICIAL
# ========================================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY

# ========================================
# CONFIGURAÇÃO FRONTEND
# ========================================
VITE_API_BASE=http://localhost:5000
# Google Authenticator 2FA — gere com: python -c "import pyotp; print(pyotp.random_base32())"
# Deixe em branco para pular 2FA em ambientes automatizados (Railway / CI).
TOTP_SECRET=
# Em ambientes sem TTY (Railway/Docker), defina também TOTP_CODE com o código atual do app:
TOTP_CODE=

# ========================================
# STREAMLIT WEB INTERFACE
# ========================================
STREAMLIT_SERVER_HEADLESS=true
PORT=8501
